{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_display_url}",
    "sources": "${mod_display_url}",
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.jvn.emeraldpouch.fabric.EmeraldPouchFabric"
    ],
    "client": [
      "com.jvn.emeraldpouch.fabric.client.EmeraldPouchFabricClient"
    ],
    "modmenu": [
      "com.jvn.emeraldpouch.fabric.client.EmeraldPouchModMenu"
    ]
  },
  "mixins": [
    {
      "config": "emeraldpouch.fabric.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "architectury": ">=${architectury_version}",
    "toucanlib": ">=${toucanlib_version}"
  }
}